generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  nim           String?        @unique
  name          String         @db.Text
  email         String         @unique
  password      String
  ktmPath       String?
  role          UserRole       @default(MAHASISWA)
  isVerified    Boolean        @default(false)
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  messages      Message[]
  refreshTokens RefreshToken[]
  reports       Report[]
  assignedReports Report[]     @relation("AssignedReports")
  passwordResetTokens PasswordResetToken[]
  // Categories this admin is assigned to handle. SUPERADMIN ignores this list
  // and has access to all categories.
  categoryAssignments AdminCategoryAssignment[] @relation("AssignmentAssignee")
  // Assignments this user (typically a SUPERADMIN) has granted to others.
  grantedAssignments  AdminCategoryAssignment[] @relation("AssignmentGrantor")
  chatPendingUploads  ChatPendingUpload[]

  @@map("users")
}

model Category {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  slug            String         @unique
  defaultPriority ReportPriority @default(MEDIUM)
  allowAnonymous  Boolean        @default(false)
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime       @updatedAt
  reports         Report[]
  adminAssignments AdminCategoryAssignment[]

  @@map("categories")
}

/**
 * Per-category admin assignment.
 *
 * SUPERADMINs grant individual ADMINs access to one or more categories. An
 * ADMIN with no rows here cannot see any reports. SUPERADMIN itself has access
 * to all categories implicitly and does not appear in this table.
 */
model AdminCategoryAssignment {
  id          Int      @id @default(autoincrement())
  adminId     Int
  categoryId  Int
  assignedById Int
  assignedAt  DateTime @default(now())

  admin       User     @relation("AssignmentAssignee", fields: [adminId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignedBy  User     @relation("AssignmentGrantor", fields: [assignedById], references: [id])

  @@unique([adminId, categoryId])
  @@index([adminId])
  @@index([categoryId])
  @@map("admin_category_assignments")
}

model Report {
  id                 Int            @id @default(autoincrement())
  registrationNumber String         @unique
  title              String
  description        String         @db.Text
  status             ReportStatus   @default(PENDING)
  priority           ReportPriority @default(MEDIUM)
  isAnonymous        Boolean        @default(false)
  userId             Int?
  categoryId         Int?
  assignedToId       Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  closedAt           DateTime?
  deletedAt          DateTime?
  attachments        Attachment[]
  messages           Message[]
  category           Category?      @relation(fields: [categoryId], references: [id])
  user               User?          @relation(fields: [userId], references: [id])
  assignedTo         User?          @relation("AssignedReports", fields: [assignedToId], references: [id])
  chatPendingUploads ChatPendingUpload[]

  @@index([userId, status, categoryId])
  @@index([categoryId], map: "reports_categoryId_idx")
  @@index([status])
  @@index([status, categoryId])
  @@index([priority, status])
  @@index([assignedToId])
  @@map("reports")
}

model Attachment {
  id         Int       @id @default(autoincrement())
  filePath   String
  fileName   String
  fileType   String
  reportId   Int
  messageId  Int?      
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  report     Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("attachments")
}

model Message {
  id              Int       @id @default(autoincrement())
  content         String    @db.Text
  senderId        Int
  reportId        Int
  clientMessageId String?   @db.VarChar(64)
  createdAt       DateTime  @default(now())
  isRead          Boolean   @default(false)
  deletedAt       DateTime?
  replyToId       Int?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([reportId, senderId, clientMessageId])
  @@index([reportId, createdAt])
  @@index([senderId], map: "messages_senderId_idx")
  @@map("messages")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique @db.VarChar(64)
  userId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  deviceId   String
  deviceName String
  ipAddress  String?
  lastUsedAt DateTime @default(now())
  userAgent  String   @db.Text
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastUsedAt])
  @@map("refresh_tokens")
}

enum UserRole {
  MAHASISWA
  ADMIN
  SUPERADMIN
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AuditEntity { 
  USER 
  REPORT 
  CATEGORY
  ASSIGNMENT
}

enum AuditAction { 
  SOFT_DELETE 
  RESTORE 
  HARD_DELETE
  UPDATE_STATUS
  VERIFY_MAHASISWA 
  VIEW_ANONYMOUS
  CREATE
  UPDATE
  PROMOTE_ADMIN
  DEMOTE_ADMIN
  GRANT_CATEGORY
  REVOKE_CATEGORY
}

model AuditLog {
  id          Int          @id @default(autoincrement())
  entityType  AuditEntity
  action      AuditAction
  entityId    Int
  actorId     Int
  actorName   String?
  actorRole   String
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

model ChatPendingUpload {
  id         Int      @id @default(autoincrement())
  token      String   @unique @db.VarChar(64)
  reportId   Int
  uploaderId Int
  filePath   String
  fileName   String
  fileType   String
  fileSize   Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  report     Report   @relation(fields: [reportId], references: [id], onDelete: Restrict)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([reportId, uploaderId])
  @@index([expiresAt])
  @@map("chat_pending_uploads")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}