# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# Server
PORT=6060
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/pengaduan?schema=public"

# JWT Secrets
# FATAL ERROR IN PRODUCTION if not met: These MUST be at least 32 characters long
# and MUST NOT be default values. Generate random strings (e.g. using openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-minimum-32-characters-required-in-prod"
JWT_REFRESH_SECRET="your-refresh-secret-minimum-32-characters-required-in-prod"
JWT_EXPIRES_IN=1d

# File Upload
UPLOAD_DIR="./uploads"
FILE_SIZE_LIMIT=5

# Frontend URL (for CORS and email links)
# REQUIRED IN PRODUCTION
FRONTEND_URL="http://localhost:5173"

# SMTP Email (optional — notifications disabled if not set)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Pengaduan Kemahasiswaan <noreply@domain.com>"

# Geolocation (optional)
GEOLOCATION_TEST_MODE=false

# Email domain whitelist for student registration (comma-separated, empty = allow all)
# ALLOWED_EMAIL_DOMAINS=mahasiswa.bunghatta.ac.id,bunghatta.ac.id

# SUPERADMIN bootstrap (seed only — these are read on `prisma db seed` when no
# SUPERADMIN exists yet, then ignored on subsequent seeds).
# Falls back to ADMIN_* if not set, but the resulting account is still
# created with role=SUPERADMIN.
SEED_SUPERADMIN_EMAIL="superadmin@kampus.ac.id"
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_PASSWORD="change-me-strong-password"

# Redis
REDIS_URL="redis://localhost:6379"
