# =========================================================================
# Docker Compose Root Environment Variables
# =========================================================================
# Copy this file to '.env' in the root folder and configure your production values:
# cp .env.example .env

# Allowed Frontend URLs for CORS (comma-separated for multiple URLs)
# Set this to your VPS IP/port or your domain name
FRONTEND_URL=https://localhost:8085

# PostgreSQL Configuration
# POSTGRES_PASSWORD wajib diisi password acak yang kuat (mis. `openssl rand -base64 24`).
# Sengaja dikosongkan: compose menolak start sampai diisi.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pengaduan

# Public HTTP Port for Frontend
# Port ini tidak boleh bisa diakses langsung dari internet: klien bisa melewati
# proxy kampus, memalsukan IP lewat X-Forwarded-For, dan menghindari rate limit.
# - Reverse proxy HTTPS di server yang sama: biarkan 127.0.0.1:8085.
# - Reverse proxy di mesin lain: isi IP jaringan internal, mis. 10.0.0.5:8085,
#   dan batasi aksesnya dengan firewall (port Docker melewati ufw).
PUBLIC_HTTP_PORT=127.0.0.1:8085

# Tautan di Pusat Bantuan (opsional, dibaca saat build image frontend).
# Kosongkan bila belum ada; tautan tidak akan ditampilkan.
VITE_USER_MANUAL_URL=
VITE_PRIVACY_POLICY_URL=

# Super Admin Seed Configuration (used when seeding the database)
# SEED_SUPERADMIN_PASSWORD wajib diisi (minimal 12 karakter) dan hanya dipakai
# saat akun superadmin pertama kali dibuat. Sengaja dikosongkan: compose menolak
# start sampai diisi, dan seed produksi menolak password contoh lama.
SEED_SUPERADMIN_EMAIL=superadmin@kampus.ac.id
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_PASSWORD=
