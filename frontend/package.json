{
  "name": "websitepengaduankemahasiswaan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build && npx vite-bundle-analyzer dist/stats.html",
    "build:production": "NODE_ENV=production vite build --mode production",
    "build:size-check": "npm run build && bundlesize",
    "optimize:images": "node scripts/optimize-images.js",
    "build:optimized": "npm run optimize:images && npm run build:production",
    "preview": "vite preview",
    "preview:compression": "vite preview --headers.content-encoding=gzip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "analyze:bundle": "vite build --mode analyze && npx vite-bundle-analyzer",
    "analyze:deps": "npx depcheck",
    "analyze:size": "npx size-limit",
    "perf:lighthouse": "npx lighthouse http://localhost:4173 --output html --output-path ./lighthouse-report.html",
    "test:component": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers vitest run",
    "test:run": "npm run test:component",
    "test:e2e": "E2E_BASE_URL=http://127.0.0.1:5199 E2E_FRONTEND_PORT=5199 E2E_BACKEND_PORT=6061 PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright install chromium"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.6",
    "@fontsource/roboto": "^5.2.6",
    "@mui/icons-material": "^7.1.1",
    "@mui/lab": "^7.0.0-beta.13",
    "@mui/material": "^7.2.0",
    "axios": "^1.10.0",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.8",
    "mammoth": "^1.9.1",
    "react": "^19.1.0",
    "react-doc-viewer-plus": "^1.0.4",
    "react-dom": "^19.1.0",
    "react-pdf": "^10.0.1",
    "react-router-dom": "^7.6.2",
    "recharts": "^2.15.3",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.30.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.17",
    "terser": "^5.43.1",
    "vite": "^6.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.7"
  }
}
