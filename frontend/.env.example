# Frontend Environment Variables
# Copy this file to .env and fill in values

# API base URL (with /v1/api prefix)
VITE_API_URL=http://localhost:6060/v1/api

# Backend base URL (without path, for axios defaults and socket)
VITE_BACKEND_URL=http://localhost:6060

# Socket.IO server URL
VITE_SOCKET_URL=http://localhost:6060

# Feature flags (optional)
VITE_USE_MEMORY_TOKEN=false
