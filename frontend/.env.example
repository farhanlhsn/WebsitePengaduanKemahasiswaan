# Frontend Environment Variables
# Copy this file to .env and fill in values (for local dev with `npm run dev`)

# API base URL used by axios (must include /v1/api prefix)
VITE_API_URL=http://localhost:6060/v1/api

# Socket.IO server URL (optional — defaults to host derived from VITE_API_URL)
VITE_SOCKET_URL=http://localhost:6060
VITE_ENABLE_SSO=false
VITE_SSO_PROVIDER=google
VITE_SSO_PROVIDER_NAME="SSO Google"
